# BrandGuard Environment Configuration Example

# Application
APP_NAME=BrandGuard
ENVIRONMENT=development
# Generate a stable, random 32+ byte value for production.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Database (PostgreSQL via Neon in production; SQLite local fallback)
DATABASE_URL=sqlite:///./brandguard.db
# Production Neon URL example:
# DATABASE_URL=postgresql://user:password@ep-aged-grass-12345.us-east-2.aws.neon.tech/brandguard?sslmode=require

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# LLM Review Engine
# Set to 'anthropic' and supply LLM_API_KEY for Claude live checks.
# If omitted or set to 'mock', the app runs in deterministic offline mode (no key needed).
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=

# Embeddings (production default is tfidf for 512MB RAM budget)
EMBEDDING_BACKEND=tfidf

# Demo sample data and one-click demo role switching. Enable only for a throwaway demo workspace.
DEMO_MODE=false

# Keep image processing opt-in for private/local workspaces; Render enables it with Tesseract.
IMAGE_REVIEW_ENABLED=false
MAX_UPLOAD_SIZE_MB=5
OCR_BACKEND=tesseract

# Comma-separated exact origins only when the UI is hosted separately. The local Vite proxy needs no CORS entry.
CORS_ORIGINS=
