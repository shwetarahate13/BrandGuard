# BrandGuard Environment Configuration Example

# Application
APP_NAME=BrandGuard
ENVIRONMENT=development
# setup_local.py generates this value for local use; production needs a stable 32+ byte value.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# SQLite is used by default. Set DATABASE_URL in your private .env only when using PostgreSQL.

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_PATH=./data/models/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=12

# LLM Review Engine
# Set to 'anthropic' and supply LLM_API_KEY for Claude live checks.
# If omitted or set to 'mock', the app runs in deterministic offline mode (no key needed).
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=

# Local judge/demo workspace: setup_local.py seeds the four throwaway accounts and sample content.
DEMO_MODE=true

# Local setup installs pip-only OCR and enables image review.
IMAGE_REVIEW_ENABLED=true
MAX_UPLOAD_SIZE_MB=25
MAX_TEXT_WORDS=20000
OCR_BACKEND=rapidocr

# Comma-separated exact origins only when the UI is hosted separately. The local Vite proxy needs no CORS entry.
CORS_ORIGINS=
